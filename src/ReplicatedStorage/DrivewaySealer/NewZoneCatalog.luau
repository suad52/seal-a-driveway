function Catalog.complete(zone, sealed)
	for _, key in ipairs(zone.keys) do if sealed[key] ~= true then return false end end
	return #zone.keys > 0
end

local extra = {{"Bridge","NewZone.Zones.Bridge.Surfaces.Surface43"},{"Bridge","NewZone.Zones.Bridge.Surfaces.Surface44"},{"Park","NewZone.Zones.Park.Surfaces.Surface15"},{"MinigZone","NewZone.Zones.MinigZone.Surfaces.Surface08"},{"MinigZone","NewZone.Zones.MinigZone.Surfaces.Surface09"},{"MinigZone","NewZone.Zones.MinigZone.Surfaces.Surface10"},{"MinigZone","NewZone.Zones.MinigZone.Surfaces.Surface11"},{"StarterZone","NewZone.Zones.StarterZone.Surfaces.Surface02"}}
for _, entry in ipairs(extra) do
	local found=false
	for _, zone in ipairs(Catalog.Zones) do
		if zone.id==entry[1] then
			assert(not table.find(zone.keys,entry[2]),"Duplicate new road key")
			table.insert(zone.keys,entry[2]);found=true;break
		end
	end
	assert(found,"Missing restoration zone: "..entry[1])
end
return Catalog
